# ===== Banco =====
DATABASE_URL=postgresql://affiliate:SENHA@localhost:5432/affiliate

# ===== Evolution API (WhatsApp) =====
EVOLUTION_URL=http://localhost:8080
EVOLUTION_APIKEY=                      # key global (AUTHENTICATION_API_KEY do docker-compose da Evolution)
EVOLUTION_INSTANCE=affiliate-fitness   # instância dedicada do número novo (criar via scripts/setup-groups.js)
OWNER_JID=5519XXXXXXXXX@s.whatsapp.net # seu número pessoal: recebe resumos e envia comandos

# ===== Shopee Affiliate Open Platform =====
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# ===== Mercado Livre =====
# Sem API oficial de afiliados. Caminho seguro: importar links gerados no portal (POST /offers/manual).
# O conversor automático (matt_word/matt_tool) viola os T&C do programa — use por sua conta e risco.
MELI_AUTO_LINKS=false
MELI_MATT_WORD=
MELI_MATT_TOOL=

# ===== Telegram (monitor de canais públicos de promo) =====
# Crie api_id/api_hash em https://my.telegram.org e rode: npm run telegram:login
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# ===== IA (copy) =====
# Provedor que gera o gancho da copy. DEFAULT 'ollama' (local, grátis). Troque
# para 'anthropic' (Claude) ou 'openai' (ChatGPT) para melhor qualidade (requer
# chave). Dá pra fazer tudo pelo painel: aba Config → IA (copy) (banco > .env).
COPY_PROVIDER=ollama                    # 'ollama' | 'anthropic' | 'openai'

# -- Ollama (local) --
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# -- Claude / Anthropic (só usado quando COPY_PROVIDER=anthropic) --
ANTHROPIC_API_KEY=                      # sk-ant-...  (sem chave, o provedor anthropic cai no template)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_TIMEOUT_MS=30000            # opcional; timeout da chamada /v1/messages

# -- OpenAI / ChatGPT (só usado quando COPY_PROVIDER=openai) --
OPENAI_API_KEY=                         # sk-...  (sem chave, o provedor openai cai no template)
OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_MS=30000               # opcional; timeout da chamada /v1/chat/completions

# ===== Instagram (auto-post das ofertas — API oficial "Instagram API with Instagram Login") =====
# Setup: app no developers.facebook.com → produto Instagram com Instagram Login.
# Conta deve ser Business/Creator. Tudo editável também pelo painel (aba Configuração).
IG_ENABLED=false                        # liga o auto-post no feed
IG_USER_ID=                             # id numérico da conta (preenchido pelo /me ao conectar)
IG_ACCESS_TOKEN=                        # SEGREDO: token long-lived (60d) — obtido no painel (Conectar/Validar)
IG_APP_ID=                              # Instagram App ID (do Meta app)
IG_APP_SECRET=                          # SEGREDO: Instagram App Secret
# IG_GRAPH_VERSION=v23.0
# PUBLIC_BASE_URL=https://seu-dominio.ngrok-free.dev   # URL pública HTTPS (OAuth callback + proxy de imagem)
# IG_PROXY_IMAGES=false                 # true = serve a imagem via /img/ig/<id>.jpg (fontes que dão WebP)
# IG_POST_EVERY_HOURS=3                 # espaçamento mínimo entre posts
# IG_DAILY_CAP=8                        # teto/dia (limite oficial da Meta é ~25/24h)
# IG_MIN_SCORE=0                        # 0 = usa MIN_SCORE do ranking
# IG_CAPTION=...                        # template ({titulo} {preco_bloco} {link} {hashtags})
# IG_HASHTAGS=#achadinhos #fitness ...

# ===== App =====
PORT=3210
TZ=America/Sao_Paulo
ADMIN_TOKEN=                            # token para os endpoints administrativos HTTP
WEBHOOK_TOKEN=                          # segredo no path do webhook da Evolution (/webhook/evolution/<token>).
                                        # Sem ele o payload é forjável por qualquer host com acesso à porta.
                                        # Defina ANTES de rodar scripts/setup-groups.js (que registra a URL).

# ===== Operação =====
POSTING_WINDOW=08:00-22:00
RAMP_SCHEDULE=4,8,12                    # posts/dia: semana 1, semana 2, semana 3+
GROUP_SPACING_MS=60000-180000           # espera aleatória entre grupos no mesmo post
SEND_DELAY_MS=3000-8000                 # options.delay da Evolution (simula digitação)
DEDUP_DAYS=7                            # não repostar o mesmo produto por N dias
OFFER_TTL_HOURS=24                      # oferta mais velha que isso expira sem postar

# ===== Pisos do ranking (score misto) =====
MIN_COMMISSION=0.05
MIN_DISCOUNT=10
MIN_SALES=30
MIN_RATING=4.3
MIN_SCORE=30
